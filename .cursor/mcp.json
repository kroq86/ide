{
  "mcpServers": {
    "docs-memory": {
      "command": "sh",
      "args": [
        "-lc",
        "DOCS_ROOT=\"${DOCS_ROOT:-$PWD}\" exec \"${DOCS_MEMORY_PYTHON:-python3}\" -m docs_memory_mcp"
      ],
      "env": {
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_EMBED_MODEL": "nomic-embed-text"
      }
    }
  }
}
