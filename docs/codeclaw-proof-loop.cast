[1.010, "o", "\r\n\u001b[1;36m4. Structured patch proposal\u001b[0m\r\n"]
[0.465, "o", "Root cause:\r\n  add() subtracts b from a, so add(2, 3) returns -1 instead of 5.\r\n\r\nRisk:\r\n  low - small single-file patch with verification command\r\n\r\nPatch:\r\n  examples/broken-counter/src/counter.ts\r\n    - return a - b\r\n    + return a + b\r\n\r\nVerify:\r\n  npm --prefix examples/broken-counter test\r\n\r\nAccept? [a] apply  [r] reject  [e] edit prompt\r\n"]
[1.310, "o", "\r\n\u001b[1;36m5. Press a to apply\u001b[0m\r\n"]
[0.488, "o", "\r\n\u001b[1;90m$ sed -n 1,8p examples/broken-counter/src/counter.ts\u001b[0m\r\n"]
[0.365, "o", "export function add(a: number, b: number): number {\r\n  return a + b\r\n}\r\n"]
[0.001, "o", "\r\n\u001b[1;36m6. CodeClaw reruns the verify command\u001b[0m\r\n"]
[0.460, "o", "\r\n\u001b[1;90m$ npm --prefix examples/broken-counter test\u001b[0m\r\n"]
[0.530, "o", "\r\n> broken-counter@0.0.0 test\r\n> cd ../.. && npm --prefix app exec tsx examples/broken-counter/test/counter.test.ts\r\n\r\n"]
[0.714, "o", "broken-counter tests passed\r\n"]
[0.017, "o", "\r\n\u001b[1;36m7. Trace saved\u001b[0m\r\n"]
